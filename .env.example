# Copy this file to .env and fill in your values. Never commit .env.
# EXPO_PUBLIC_* variables are inlined into the app bundle, so only put
# values here that are safe to ship to clients (the Supabase anon key is).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Maps API key for Android builds (read by app.config.ts at build time).
GOOGLE_MAPS_ANDROID_API_KEY=
